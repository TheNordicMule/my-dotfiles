# EXAMPLE — a template for `nixos/hardware-configuration.nix`, which is a
# generated, local, gitignored per-machine file. This example file IS tracked;
# the real generated file is NOT.
#
# The real file is produced on the target by
# `nixos-generate-config --root /mnt --dir <repo>/nixos`, is listed in
# .gitignore, and is never staged/committed. Commands that must see it
# (nixos-install / nixos-rebuild) use explicit `path:` flake refs
# (`path:/mnt/home/mingshiwang/my-dotfiles#nixos-desktop`, or `path:.` from
# inside the repo). See nixos/README.md.
#
# Two legitimate uses of this example:
#   1. Pre-install dry-run: copy it to `nixos/hardware-configuration.nix` so
#      the flake can be evaluated before the target's real file exists. It is a
#      documented, deliberate stub — the target will be built against it until
#      the real generated file replaces it.
#   2. Reference for what the installer will generate.
# For a real install, use the actual output of `nixos-generate-config` (values
# differ from this template).
#
# Generated by ‘nixos-generate-config’ (this is a template; values differ).
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:
{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "nvme"
    "usb_storage"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [];
  boot.kernelModules = ["kvm-amd"];
  boot.extraModulePackages = [];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/REPLACE-WITH-ROOT-UUID";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/REPLACE-WITH-EFI-UUID";
    fsType = "vfat";
    options = ["fmask=0077" "dmask=0077"];
  };

  swapDevices = [];

  # Enables DHCP on each ethernet and wireless interface.
  networking.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  # NVIDIA RTX GPU — firmware/microcode updates are redistributable and fine
  # with hardware.nvidia.open = true (see nixos/configuration.nix).
  hardware.cpu.amd.updateMicrocode =
    lib.mkDefault config.hardware.enableRedistributableFirmware;
}
