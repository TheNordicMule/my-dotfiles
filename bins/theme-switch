#!/usr/bin/env zsh
set -e

# Usage: theme-switch nord | theme-switch catppuccin | theme-switch gruvbox
#
# Changes the `theme` value in modules/theme.nix, rebuilds — Nix propagates to
# starship, wezterm, bat, nvim, sketchybar, opencode (tui theme via
# programs.opencode), spotify-player, and zsh (autosuggestion color) — then
# reloads the running session: sketchybar on macOS, and Hyprland plus the
# waybar/swaync user units on Linux (all best-effort, so a reload can never
# fail the script after a successful rebuild). Restart Neovim, OpenCode, and
# spotify-player; open a new Zsh session for the autosuggestion color.

NEW_THEME="$1"
case "$NEW_THEME" in
  nord|catppuccin|gruvbox) ;;
  *)
    echo "Usage: theme-switch nord|catppuccin|gruvbox" >&2
    exit 1
    ;;
esac

REPO=~/my-dotfiles

# BSD sed (macOS) requires `-i ''`; GNU sed (Linux/NixOS) takes a bare `-i`.
case "$(uname -s)" in
  Darwin)
    SED_INPLACE=(-i '')
    ;;
  Linux)
    SED_INPLACE=(-i)
    ;;
  *)
    echo "theme-switch: unsupported OS $(uname -s)" >&2
    exit 1
    ;;
esac

# 1. Update the `theme` value in modules/theme.nix
sed "$SED_INPLACE[@]" "s/^  config.dotfiles.theme = \".*\";/  config.dotfiles.theme = \"$NEW_THEME\";/" "$REPO/modules/theme.nix"

# 2. Rebuild — Nix propagates to starship, wezterm, bat, nvim, sketchybar,
#    opencode (tui theme via programs.opencode), spotify-player, and zsh
#    (autosuggestion color; applies in newly started Zsh sessions).
pushd "$REPO"
alejandra . &>/dev/null

# Rebuild the active OS: darwin-rebuild on macOS, nixos-rebuild (host
# nixos-desktop) on Linux. darwin-rebuild must keep its --flake . form; the
# Linux branch uses `path:.` so the untracked, gitignored
# nixos/hardware-configuration.nix is visible to Nix.
case "$(uname -s)" in
  Darwin)
    sudo darwin-rebuild switch --flake .
    ;;
  Linux)
    sudo nixos-rebuild switch --flake path:.#nixos-desktop
    ;;
  *)
    echo "theme-switch: unsupported OS $(uname -s)" >&2
    exit 1
    ;;
esac
popd

# 3. Reload the running session so the new config applies. Best-effort only:
#    with `set -e`, a failed reload must never fail the script after the
#    rebuild already succeeded, so every command ignores failures (`|| true`).
#    macOS: reload sketchybar so it re-sources colors.sh with the new theme
#    (colors.sh reads ~/.config/theme at source time via sketchybarrc).
#    Linux: reload Hyprland for borders/colors and restart the waybar/swaync
#    user units so they re-read their re-rendered configs. (No Mako — SwayNC
#    is the current notification daemon.)
if [[ "$(uname -s)" == "Darwin" ]]; then
  sketchybar --reload || true
elif [[ "$(uname -s)" == "Linux" ]]; then
  hyprctl reload || true
  systemctl --user restart waybar swaync || true
fi

echo "Theme switched to $NEW_THEME. Reloaded sketchybar (macOS) or Hyprland + waybar/swaync (Linux). Restart Neovim, OpenCode, and spotify-player; open a new Zsh session for the autosuggestion color."
