#!/usr/bin/env zsh
set -e
pushd ~/my-dotfiles
nixfmt . &>/dev/null

# Rebuild the active OS: `nh darwin switch` on macOS, `nh os switch` (host
# nixos-desktop) on Linux. nh self-elevates internally, so no `sudo` here. The
# Linux branch keeps the `path:.` flake reference so the untracked, gitignored
# nixos/hardware-configuration.nix is visible to Nix (a git ref would hide it).
case "$(uname -s)" in
  Darwin)
    nh darwin switch . -H Mac-that-vim
    ;;
  Linux)
    nh os switch path:. -H nixos-desktop
    ;;
  *)
    echo "switch: unsupported OS $(uname -s)" >&2
    exit 1
    ;;
esac

git commit -a
popd
